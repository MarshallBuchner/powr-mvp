# POWR Recruit env vars
#
# Required for live Stripe Checkout:
STRIPE_SECRET_KEY=sk_test_...

# Optional: reuse a stable Stripe Price ID once created in Dashboard.
# If omitted, checkout creates an inline CAD $39 price_data line item.
# STRIPE_RECRUIT_PRICE_ID=price_...

# Optional site URL override for success/cancel redirects
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
